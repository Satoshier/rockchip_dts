# 11 "arch/arm64/boot/dts/rockchip/tl3576-evm.dts" 2
# 1 "arch/arm64/boot/dts/rockchip/rk3576-linux.dtsi" 1






/ {
 chosen: chosen {
  bootargs = "earlycon=uart8250,mmio32,0x2ad40000 console=ttyFIQ0 root=PARTUUID=614e0000-0000 rw rootwait rcupdate.rcu_expedited=1 rcu_nocbs=all";
 };

 fiq_debugger: fiq-debugger {
  compatible = "rockchip,fiq-debugger";
  rockchip,serial-id = <0>;
  rockchip,wake-irq = <0>;

  rockchip,irq-mode-enable = <1>;
  rockchip,baudrate = <1500000>;
  interrupts = <0 389 8>;
  pinctrl-names = "default";
  pinctrl-0 = <&uart0m0_xfer>;
  status = "okay";
 };

 firmware {
  optee: optee {
   compatible = "linaro,optee-tz";
   method = "smc";
  };
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  drm_logo: drm-logo@0 {
   compatible = "rockchip,drm-logo";
   reg = <0x0 0x0 0x0 0x0>;
  };

  drm_cubic_lut: drm-cubic-lut@0 {
   compatible = "rockchip,drm-cubic-lut";
   reg = <0x0 0x0 0x0 0x0>;
  };

  ramoops: ramoops@40110000 {
   compatible = "ramoops";

   reg = <0x0 0x40110000 0x0 0xe0000>;
   boot-log-size = <0x8000>;
   boot-log-count = <0x1>;
   console-size = <0x80000>;
   pmsg-size = <0x30000>;
   ftrace-size = <0x00000>;
   record-size = <0x14000>;
  };
 };
};

&dfi {
 status = "okay";
};

&display_subsystem {
 memory-region = <&drm_logo>, <&drm_cubic_lut>;
 memory-region-names = "drm-logo", "drm-cubic-lut";

};

&dmc {
 status = "okay";
 center-supply = <&vdd_ddr_s0>;
 mem-supply = <&vdd_logic_s0>;
};

&rng {
 status = "okay";
};
# 12 "arch/arm64/boot/dts/rockchip/tl3576-evm.dts" 2


/ {
 model = "TL3576-EVM";
 compatible = "tronlong,tl3576-evm", "rockchip,rk3576";

 vbus5v0_typec: vbus5v0-typec {

  compatible = "regulator-fixed";
  regulator-name = "vbus5v0_typec";
  regulator-min-microvolt = <5000000>;
  regulator-max-microvolt = <5000000>;
  enable-active-high;
  gpio = <&xl9555 7 0>;
  vin-supply = <&vcc5v0_device>;
 };


 clk16m: clk16m {
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <16000000>;
        };

 wireless_bluetooth: wireless-bluetooth {
  compatible = "bluetooth-platdata";

  status = "okay";
 };

 fcs950u_bsp: sprd-marlin3 {
  compatible = "sprd,marlin3";
  sprd,btwf-file-name = "/vendor/etc/wcnmodem.bin";
  sdhci-name = <&sdio>;
  keep-power-on;
  m2-wakeup-ap-gpios = <&gpio1 28 0>;
  m2-to-ap-irq-gpios = <&gpio0 0 0>;
  status = "okay";
 };


 sdio_pwrseq: sdio-pwrseq {
  compatible = "mmc-pwrseq-simple";







  post-power-on-delay-ms = <200>;
  status = "okay";
 };


 sprd-wlan {
  compatible = "sprd,sc2355-wifi";
 };

 wireless_wlan: wireless-wlan {
  compatible = "wlan-platdata";
  wifi_chip_type = "ap6275p";
  pinctrl-names = "default";
  pinctrl-0 = <&wifi_host_wake_irq>;
  WIFI,host_wake_irq = <&gpio1 28 0>;
  /delete-property/ WIFI,host_wake_irq;
  status = "okay";
 };

 imx219_clk: imx219-clk {
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <24000000>;
                clock-output-names = "imx219_clk";
        };

 ov9281_clk: imx219-clk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <24000000>;
  clock-output-names = "ov9281_clk";
 };

 fan: pwm-fan {
  compatible = "pwm-fan";
  #cooling-cells = <2>;
  pwms = <&pwm0_2ch_0 0 50000 0>;
  cooling-levels = <0 50 100 150 200 255>;
  rockchip,temp-trips = <
   25000 5
  >;
 };

 leds {
  status = "okay";
  compatible = "gpio-leds";
  pinctrl-names = "default";
  pinctrl-0 = <&som_led0 &som_led1 &user_led0 &user_led1>;


  som_led0 {
   label = "heartbeat";
   gpios = <&gpio0 14 0>;
   linux,default-trigger = "heartbeat";
   default-state = "off";
  };


  som_led1 {
   label = "disk";
   gpios = <&gpio0 26 0>;
   linux,default-trigger = "mmc0";
   default-state = "off";
  };

  user_led0 {
   label = "user-led0";
   gpios = <&gpio0 13 0>;
   linux,default-trigger = "default-on";
   default-state = "off";
  };

  user_led1 {
   label = "user-led1";
   gpios = <&gpio0 12 0>;
   linux,default-trigger = "default-on";
   default-state = "off";
  };
 };


     pps {
  pinctrl-names = "default";
  pinctrl-0 = <&pps_gpio>;
  compatible = "pps-gpio";
  gpios = <&gpio2 21 0>;

                assert-rising-edge;
                status = "okay";
 };

 gpio-keys {
  compatible = "gpio-keys";
  autorepeat;
  pinctrl-names = "default";
  pinctrl-0 = <&user_key0>;

  user_key0 {
   label = "user-key1";
   linux,code = <149>;
   gpios = <&gpio1 11 1>;
   debounce-interval = <0>;
  };
 };

        adc-keys1 {
            compatible = "adc-keys";
            io-channels = <&saradc 0>;
            io-channel-names = "buttons";
            keyup-threshold-microvolt = <1800000>;
            poll-interval = <100>;

                user_key2 {
                    label = "user-key2";
                    linux,code = <202>;
                    press-threshold-microvolt = <1750>;
                };
        };

        adc-keys2 {
            compatible = "adc-keys";
            io-channels = <&saradc 1>;
            io-channel-names = "buttons";
            keyup-threshold-microvolt = <1800000>;
            poll-interval = <100>;

                user_key0 {
                    label = "user-key0";
                    linux,code = <148>;
                    press-threshold-microvolt = <1750>;
                };
        };
# 208 "arch/arm64/boot/dts/rockchip/tl3576-evm.dts"
};





&vcc_mipicsi1 {
        status = "disabled";
};
&vcc_mipidcphy0 {
        status = "disabled";
};



&spi0 {
        pinctrl-0 = <&spi0m1_csn0 &spi0m1_csn1 &spi0m1_pins>;
        status = "okay";

        xl2515@0 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int0>;
                reg = <0>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio2>;
                interrupts = <3 8>;
                status = "okay";
      };

        xl2515@1 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int1>;
                reg = <1>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio2>;
                interrupts = <28 8>;
                status = "okay";
      };
};

&spi1 {
        pinctrl-0 = <&spi1m2_csn0 &spi1m2_csn1 &spi1m2_pins>;
        status = "okay";

        xl2515@0 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int2>;
                reg = <0>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio3>;
                interrupts = <9 8>;
                status = "okay";
      };

        xl2515@1 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int3>;
                reg = <1>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio3>;
                interrupts = <7 8>;
                status = "okay";
      };
};

&spi2 {
        pinctrl-0 = <&spi2m2_csn0 &spi2m2_csn1 &spi2m2_pins>;
        status = "okay";

        xl2515@0 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int4>;
                reg = <0>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio4>;
                interrupts = <1 8>;
                status = "okay";
      };

        xl2515@1 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int5>;
                reg = <1>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio3>;
                interrupts = <6 8>;
                status = "okay";
      };
};

&spi3 {
        pinctrl-0 = <&spi3m1_csn0 &spi3m1_csn1 &spi3m1_pins>;
        status = "okay";

        xl2515@0 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int6>;
                reg = <0>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio3>;
                interrupts = <13 8>;
                status = "okay";
      };

        xl2515@1 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int7>;
                reg = <1>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio4>;
                interrupts = <4 8>;
                status = "okay";
      };
};

&spi4 {
        pinctrl-0 = <&spi4m2_csn0 &spi4m2_csn1 &spi4m2_pins>;
        status = "okay";

        xl2515@0 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int8>;
                reg = <0>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio4>;
                interrupts = <12 8>;
                status = "okay";
      };

        xl2515@1 {
                compatible = "microchip,mcp2515";
                pinctrl-names = "default";
                pinctrl-0 = <&xl2515_int9>;
                reg = <1>;
                clocks = <&clk16m>;
                spi-max-frequency = <10000000>;
                interrupt-parent = <&gpio4>;
                interrupts = <3 8>;
                status = "okay";
      };
};


