 vo0_grf: syscon@2601a000 {
  compatible = "rockchip,rk3576-vo0-grf", "syscon";
  reg = <0x0 0x2601a000 0x0 0x2000>;
  clocks = <&cru 405>;
 };

 usb_grf: syscon@2601e000 {
  compatible = "rockchip,rk3576-usb-grf", "syscon";
  reg = <0x0 0x2601e000 0x0 0x1000>;
