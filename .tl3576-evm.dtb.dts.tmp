  resets = <&cru 1033>, <&cru 524317>;
  reset-names = "ref", "hdp";
  power-domains = <&power 16>;
  pinctrl-names = "default";
  pinctrl-0 = <&hdmi_txm0_pins &hdmi_tx_scl &hdmi_tx_sda>;
