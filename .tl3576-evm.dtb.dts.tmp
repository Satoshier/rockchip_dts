&dsi {
 status = "okay";

 dsi_panel: panel@0 {
  status = "okay";
  compatible = "simple-panel-dsi";
  reg = <0>;
  backlight = <&backlight>;
  reset-delay-ms = <200>;
  enable-delay-ms = <200>;
  prepare-delay-ms = <200>;
  unprepare-delay-ms = <200>;
  disable-delay-ms = <200>;
  width-mm = <94>;
  height-mm = <150>;
  dsi,flags = <((1 << 0) | (1 << 1) |
         (1 << 11) | (1 << 9))>;
  dsi,format = <0>;
  dsi,lanes = <4>;
  panel-init-sequence = [
   05 1E 01 01
   23 00 02 EE 50
   29 00 03 EA 85 55
   23 00 02 30 00
   23 00 02 31 00
   29 00 03 90 50 15
   23 00 02 24 20
   23 00 02 99 00
   23 00 02 79 00
   23 00 02 95 74
   23 00 02 7A 20
   23 00 02 97 09
   23 00 02 7D 08
   23 00 02 56 83
   23 00 02 EE 60
   23 00 02 30 01
   23 00 02 27 22
   23 00 02 3A A4
   23 00 02 3B 00
   23 00 02 3C 1A
   23 00 02 3D 11
   23 00 02 3E 93
   23 00 02 42 64
   23 00 02 43 64
   23 00 02 44 0B
   23 00 02 46 4E
   23 00 02 8B 90
   23 00 02 8D 45
   23 00 02 91 11
   23 00 02 92 11
   23 00 02 93 9F
   23 00 02 9A 00
   23 00 02 9C 80
   29 00 06 47 0F 24 2C 39 36
   29 00 06 5A 0F 24 2C 39 36
   29 00 06 4C 4A 40 51 31 2F
   29 00 06 51 2D 10 25 1F 30
   29 00 05 56 37 46 5B 7F
   29 00 05 69 37 46 5B 7F
   23 00 02 EE 70
   29 00 05 00 03 07 00 01
   29 00 05 04 08 0C 55 01
   29 00 03 0C 05 3D
   29 00 06 10 05 08 00 01 05
   29 00 06 15 00 15 0D 08 00
   29 00 03 29 05 3D
   29 00 06 60 3C 3C 07 05 17
   29 00 06 65 15 13 11 01 03
   29 00 06 6A 3C 3C 3C 3C 3C
   29 00 06 6F 3C 3C 3C 3C 3C
   29 00 03 74 3C 3C
   29 00 06 80 3C 3C 06 04 16
   29 00 06 85 14 12 10 00 02
   29 00 06 8A 3C 3C 3C 3C 3C
   29 00 06 8F 3C 3C 3C 3C 3C
   29 00 03 94 3C 3C
   29 00 03 EA 00 00
   23 00 02 EE 00
   05 78 01 11
   05 1E 01 29
  ];

  panel-exit-sequence = [
   05 00 01 28
   05 00 01 10
  ];

  disp_timings0: display-timings {
   native-mode = <&dsi_timing0>;
   dsi_timing0: timing0 {
    clock-frequency = <67200000>;
                hactive = <800>;
                vactive = <1280>;
                hfront-porch = <80>;
                hsync-len = <20>;
                hback-porch = <20>;
                vfront-porch = <15>;
                vsync-len = <6>;
                vback-porch = <8>;
                hsync-active = <0>;
                vsync-active = <0>;
                de-active = <0>;
                pixelclk-active = <1>;
   };
  };

  ports {
   #address-cells = <1>;
   #size-cells = <0>;

   port@0 {
    reg = <0>;
    panel_in_dsi: endpoint {
     remote-endpoint = <&dsi_out_panel>;
    };
   };
  };
 };

 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@1 {
   reg = <1>;
   dsi_out_panel: endpoint {
    remote-endpoint = <&panel_in_dsi>;
   };
  };
 };

};

&dsi_panel {
 power-supply = <&vcc3v3_lcd_n>;


};

&vcc3v3_lcd_n{
      status = "disabled";
};


&gmac0 {

 phy-mode = "rgmii-rxid";
 clock_in_out = "output";


        snps,reset-gpio = <&gpio2 31 1>;
 snps,reset-active-low;

 snps,reset-delays-us = <0 20000 100000>;

 pinctrl-names = "default";
 pinctrl-0 = <&eth0m1_miim
       &eth0m1_tx_bus2
       &eth0m1_rx_bus2
       &eth0m1_rgmii_clk
       &eth0m1_rgmii_bus
                     &gmac0_phy_reset>;

 tx_delay = <0x21>;



 phy-handle = <&rgmii_phy0>;
 status = "okay";
};

&gmac1 {

 phy-mode = "rgmii-rxid";
 clock_in_out = "output";

 snps,reset-gpio = <&xl9555 1 1>;
 snps,reset-active-low;

 snps,reset-delays-us = <0 20000 100000>;

 pinctrl-names = "default";
 pinctrl-0 = <&eth1m0_miim
       &eth1m0_tx_bus2
       &eth1m0_rx_bus2
       &eth1m0_rgmii_clk
       &eth1m0_rgmii_bus>;

 tx_delay = <0x20>;


 phy-handle = <&rgmii_phy1>;
 status = "disabled";
};

&mdio0 {
 rgmii_phy0: phy@1 {
  compatible = "ethernet-phy-ieee802.3-c22";
  reg = <0x0>;
  clocks = <&cru 49>;
 };
};

&mdio1 {
 rgmii_phy1: phy@1 {
  compatible = "ethernet-phy-ieee802.3-c22";
  reg = <0x1>;
  clocks = <&cru 50>;
 };
};
# 1439 "arch/arm64/boot/dts/rockchip/tl3576-evm.dts"
&uart8 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&uart8m2_xfer>;
};

&uart1 {
 status = "okay";
 pinctrl-names = "default";
 pinctrl-0 = <&uart1m0_xfer &uart1m0_rtsn>;
 linux,rs485-enabled-at-boot-time;
};


&uart2 {
 status = "disabled";



};
# 1473 "arch/arm64/boot/dts/rockchip/tl3576-evm.dts"
&backlight {
        pwms = <&pwm2_8ch_6 0 25000 0>;
        status = "disabled";
};


&usbdp_phy {
# 1500 "arch/arm64/boot/dts/rockchip/tl3576-evm.dts"
        maximum-speed = "high-speed";
        status = "okay";
};

&u2phy0_otg {

 /delete-property/ rockchip,typec-vbus-det;
 rockchip,sel-pipe-phystatus;
 rockchip,dis-u2-susphy;
 status = "okay";
};

&usbdp_phy_dp {
 status = "disabled";
};

&usbdp_phy_u3 {
 status = "disabled";
};

&usb_drd0_dwc3 {
 /delete-property/ usb-role-switch;
 phys = <&u2phy0_otg>;
 phy-names = "usb2-phy";

 dr_mode = "host";
 maximum-speed = "high-speed";
 snps,dis_u2_susphy_quirk;
 snps,usb2-lpm-disable;
 status = "okay";
 /delete-node/ port;
};

&u2phy1_otg {

 rockchip,sel-pipe-phystatus;
 rockchip,dis-u2-susphy;
};

&combphy1_psu {
 rockchip,dis-u3otg1-port;
 status = "okay";
};

&usb_drd1_dwc3 {
 dr_mode = "host";


 maximum-speed = "high-speed";
 snps,dis_u2_susphy_quirk;
 snps,usb2-lpm-disable;
 status = "okay";
};




&es8388_sound {
        /delete-property/ spk-con-gpio;
        hp-det-gpio = <&gpio4 10 0>;
        hp-con-gpio = <&xl8574t 2 0>;
};


&vcc5v0_host{
        status = "disabled";
};



&hdmi {
    status = "disabled";
};



&pwm2_8ch_6{
        status = "okay";
        pinctrl-0 = <&pwm2m1_ch6>;
};



&pwm1_6ch_5{
        status = "okay";
        pinctrl-0 = <&pwm1m1_ch5>;
};



&pwm2_8ch_0{
        status = "okay";
        pinctrl-0 = <&pwm2m1_ch0>;
};


&pwm2_8ch_1{
        status = "okay";
        pinctrl-0 = <&pwm2m1_ch1>;
};


&pwm2_8ch_3{
        status = "okay";
        pinctrl-0 = <&pwm2m1_ch3>;
};


&pwm2_8ch_2{
        status = "okay";
        pinctrl-0 = <&pwm2m1_ch2>;
};


&pwm2_8ch_5{
        status = "okay";
        pinctrl-0 = <&pwm2m1_ch5>;
};


&pwm0_2ch_1{
