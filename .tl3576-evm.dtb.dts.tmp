 rockchip_suspend: rockchip-suspend {
  compatible = "rockchip,pm-config";
  status = "disabled";
  rockchip,sleep-debug-en = <0>;
  rockchip,sleep-mode-config = <
   (0
   | (1 << (3))
   | (1 << (9))
   | (1 << (10))
   | (1 << (17))
   | (1 << (24))
   )
  >;
  rockchip,wakeup-config = <
   (0
   | (1 << (8))
   )
  >;
  rockchip,sleep-io-ret-config = <
   (0)
  >;
  rockchip,sleep-pin-config = <
   (0
   | (1 << (0))
   )
   (0)
  >;
  power-domains = <&power 7>, <&power 8>;
 };

 rockchip_system_monitor: rockchip-system-monitor {
  compatible = "rockchip,system-monitor";

  rockchip,thermal-zone = "little-core-thermal";
  rockchip,early-suspend-offline-cpus = "4-7";
 };

 thermal_zones: thermal-zones {
  soc_thermal: soc-thermal {
   polling-delay-passive = <20>;
   polling-delay = <1000>;
   thermal-sensors = <&tsadc 0>;
   trips {
    soc_crit: soc-crit {

     temperature = <125000>;

     hysteresis = <2000>;
     type = "critical";
    };
   };
  };
  bigcore_thermal: bigcore-thermal {
   polling-delay-passive = <20>;
   polling-delay = <1000>;
   thermal-sensors = <&tsadc 1>;
   trips {
    bigcore_crit: bigcore-crit {

     temperature = <125000>;

     hysteresis = <2000>;
     type = "critical";
    };
   };
  };
  little_core_thermal: little-core-thermal {
   polling-delay-passive = <20>;
   polling-delay = <1000>;
   sustainable-power = <1390>;

   thermal-sensors = <&tsadc 2>;
   trips {
    threshold: trip-point-0 {
     temperature = <75000>;
     hysteresis = <2000>;
     type = "passive";
    };
    target: trip-point-1 {
     temperature = <85000>;
     hysteresis = <2000>;
     type = "passive";
    };
    little_core_crit: little-core-crit {

     temperature = <125000>;

     hysteresis = <2000>;
     type = "critical";
    };
   };
   cooling-maps {
    map0 {
     trip = <&target>;
     cooling-device = <&cpu_l0 (~0) (~0)>;
     contribution = <1024>;
    };
    map1 {
     trip = <&target>;
     cooling-device = <&cpu_b0 (~0) (~0)>;
     contribution = <1024>;
    };
    map2 {
     trip = <&target>;
     cooling-device = <&gpu (~0) (~0)>;
     contribution = <1024>;
    };
   };
  };
  ddr_thermal: ddr-thermal {
   polling-delay-passive = <20>;
   polling-delay = <1000>;
   thermal-sensors = <&tsadc 3>;
   trips {
    ddr_crit: ddr-crit {

     temperature = <125000>;

     hysteresis = <2000>;
     type = "critical";
    };
   };
  };
  npu_thermal: npu-thermal {
   polling-delay-passive = <20>;
   polling-delay = <1000>;
   thermal-sensors = <&tsadc 4>;
   trips {
    npu_crit: npu-crit {

     temperature = <125000>;

     hysteresis = <2000>;
     type = "critical";
    };
   };
  };
  gpu_thermal: gpu-thermal {
   polling-delay-passive = <20>;
   polling-delay = <1000>;
   thermal-sensors = <&tsadc 5>;
   trips {
    gpu_crit: gpu-crit {

     temperature = <125000>;

     hysteresis = <2000>;
     type = "critical";
    };
   };
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>;
 };

 debug: debug@22810000 {
  compatible = "rockchip,debug";
  reg = <0x0 0x22810000 0x0 0x1000>,
        <0x0 0x22812000 0x0 0x1000>,
        <0x0 0x22814000 0x0 0x1000>,
        <0x0 0x22816000 0x0 0x1000>,
        <0x0 0x22c10000 0x0 0x1000>,
        <0x0 0x22d10000 0x0 0x1000>,
        <0x0 0x22e10000 0x0 0x1000>,
        <0x0 0x22f10000 0x0 0x1000>;
 };

 usb_drd0_dwc3: usb@23000000 {
  compatible = "rockchip,rk3576-dwc3", "snps,dwc3";
  reg = <0x0 0x23000000 0x0 0x400000>;
  clocks = <&cru 332>,
    <&cru 333>,
    <&cru 331>;
  clock-names = "ref", "suspend", "bus_clk";
  interrupts = <0 261 4>;
  power-domains = <&power 7>;
  resets = <&cru 757>;
  reset-names = "usb3-otg";
  dr_mode = "otg";
  phys = <&u2phy0_otg>, <&usbdp_phy_u3>;
  phy-names = "usb2-phy", "usb3-phy";
  phy_type = "utmi_wide";
  snps,dis_enblslpm_quirk;
  snps,dis-u1-entry-quirk;
  snps,dis-u2-entry-quirk;
  snps,dis-u2-freeclk-exists-quirk;
  snps,dis-del-phy-power-chg-quirk;
  snps,dis-tx-ipgap-linecheck-quirk;
  snps,parkmode-disable-hs-quirk;
  snps,parkmode-disable-ss-quirk;
  status = "disabled";
 };

 usb_drd1_dwc3: usb@23400000 {
  compatible = "rockchip,rk3576-dwc3", "snps,dwc3";
  reg = <0x0 0x23400000 0x0 0x400000>;
  clocks = <&cru 268>,
    <&cru 269>,
    <&cru 267>;
  clock-names = "ref", "suspend", "bus_clk";
  interrupts = <0 260 4>;
  power-domains = <&power 8>;
  resets = <&cru 563>;
  reset-names = "usb3-otg";
  dr_mode = "otg";
  phys = <&u2phy1_otg>, <&combphy1_psu 4>;
  phy-names = "usb2-phy", "usb3-phy";
  phy_type = "utmi_wide";
  snps,dis_enblslpm_quirk;
  snps,dis-u1-entry-quirk;
  snps,dis-u2-entry-quirk;
  snps,dis-u2-freeclk-exists-quirk;
  snps,dis-del-phy-power-chg-quirk;
  snps,dis-tx-ipgap-linecheck-quirk;
  snps,dis_rxdet_inp3_quirk;
  snps,parkmode-disable-hs-quirk;
  snps,parkmode-disable-ss-quirk;
  dma-coherent;
  status = "disabled";
 };

 sys_grf: syscon@2600a000 {
  compatible = "rockchip,rk3576-sys-grf", "syscon";
  reg = <0x0 0x2600a000 0x0 0x2000>;
 };

 bigcore_grf: syscon@2600c000 {
