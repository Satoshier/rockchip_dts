 };
};

&mdio1 {
 rgmii_phy1: phy@1 {
  compatible = "ethernet-phy-ieee802.3-c22";
  reg = <0x1>;
  clocks = <&cru 50>;
 };
};

&mipidcphy0 {
 status = "okay";
};

&pcie0 {
 reset-gpios = <&gpio1 19 0>;
 rockchip,skip-scan-in-resume;
