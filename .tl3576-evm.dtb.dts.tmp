    regulator-state-mem {
     regulator-off-in-suspend;
    };
   };

   vdda0v75_hdmi_s0: NLDO_REG3 {
    regulator-always-on;
    regulator-boot-on;
    regulator-min-microvolt = <837500>;
    regulator-max-microvolt = <837500>;
