  };

  usb_otg0_pwren: usb-otg0-pwren {
   rockchip,pins = <0 25 0 &pcfg_pull_none>;
  };

 };
};

&route_hdmi {
 status = "okay";
 connect = <&vp0_out_hdmi>;
};

&sai1 {
 status = "okay";
 pinctrl-names = "default";
