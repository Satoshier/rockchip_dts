# 1632 "arch/arm64/boot/dts/rockchip/tl3576-evm.dts"
&pinctrl {
 leds {
  som_led0: som-led0 {
   rockchip,pins = <0 14 0 &pcfg_pull_none>;
  };

  som_led1: som-led1 {
   rockchip,pins = <0 26 0 &pcfg_pull_none>;
  };

  user_led0: user-led0 {
   rockchip,pins = <0 13 0 &pcfg_pull_none>;
  };

  user_led1: user-led1 {
   rockchip,pins = <0 12 0 &pcfg_pull_none>;
  };
 };

 keys {
  user_key0: user-key0 {
   rockchip,pins = <1 11 0 &pcfg_pull_none>;
  };
 };

 usb {
  usbc0_int: usbc0-int {
   rockchip,pins = <4 16 0 &pcfg_pull_up>;
  };
 };

 touch {
  gt911_int: gt911-int {
   rockchip,pins = <1 18 0 &pcfg_pull_none>;
  };
 };

 wireless-wlan {
  wifi_host_wake_irq: wifi-host-wake-irq {
   rockchip,pins = <1 28 0 &pcfg_pull_down>;
  };

  wifi_poweren_gpio: wifi-poweren-gpio {
   rockchip,pins = <1 22 0 &pcfg_pull_up>;
  };
 };

 headphone {
  hp_det: hp-det {
   rockchip,pins = <4 10 0 &pcfg_pull_none>;
  };
 };

      pps {
  pps_gpio: pps-gpio {
                        rockchip,pins = <2 21 0 &pcfg_pull_none>;
             };
 };


      xl2515 {
   xl2515_int0: xl2515-int0 {
     rockchip,pins = <2 3 0 &pcfg_pull_none>;
   };

   xl2515_int1: xl2515-int1 {
     rockchip,pins = <2 28 0 &pcfg_pull_none>;
   };
   xl2515_int2: xl2515-int2 {
     rockchip,pins = <3 9 0 &pcfg_pull_none>;
   };

   xl2515_int3: xl2515-int3 {
     rockchip,pins = <3 7 0 &pcfg_pull_none>;
   };
   xl2515_int4: xl2515-int4 {
     rockchip,pins = <4 1 0 &pcfg_pull_none>;
   };

   xl2515_int5: xl2515-int5 {
     rockchip,pins = <3 6 0 &pcfg_pull_none>;
   };
   xl2515_int6: xl2515-int6 {
     rockchip,pins = <3 13 0 &pcfg_pull_none>;
   };

   xl2515_int7: xl2515-int7 {
     rockchip,pins = <4 4 0 &pcfg_pull_none>;
   };
   xl2515_int8: xl2515-int8 {
     rockchip,pins = <4 12 0 &pcfg_pull_none>;
   };

   xl2515_int9: xl2515-int9 {
     rockchip,pins = <4 3 0 &pcfg_pull_none>;
   };
 };

        gmac0-phy-reset {
                gmac0_phy_reset: gmac0-phy-reset {
                        rockchip,pins = <2 31 0 &pcfg_pull_none>;
                };
        };







};
